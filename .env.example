# ---------------------------
# eBay
# ---------------------------
EBAY_CLIENT_ID=your_ebay_client_id
EBAY_CLIENT_SECRET=your_ebay_client_secret
EBAY_MARKETPLACE_ID=EBAY_US

# ---------------------------
# Gemini adaptive vision
# ---------------------------
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=low

# First pass: one contact-sheet overview for most listings.
# Medium is the safer default for spotting small minifigures in a montage.
GEMINI_OVERVIEW_RESOLUTION=medium

# Detailed photos only after the overview says they are promising.
GEMINI_DETAIL_RESOLUTION=medium

# High is used only as a retry for difficult/crowded photos.
GEMINI_HIGH_DETAIL_RESOLUTION=high
GEMINI_ENABLE_HIGH_DETAIL_RETRY=true

# Contact-sheet / adaptive scan controls.
CONTACT_SHEET_MAX_IMAGES=12
CONTACT_SHEET_TILE_SIZE=300
MAX_LISTING_IMAGES=12
GEMINI_MAX_DETAIL_IMAGES=5
GEMINI_INCLUDE_NEIGHBOR_PHOTOS=true

# Local image dedupe. Lower = stricter duplicate match.
IMAGE_DHASH_DISTANCE=6

# Local safety rail. 0 = unlimited.
GEMINI_MAX_CALLS_PER_CYCLE=100
GEMINI_LOG_USAGE=true

# Informational local cost estimate only.
GEMINI_INPUT_PRICE_PER_MILLION=0.75
GEMINI_OUTPUT_PRICE_PER_MILLION=3.75

# ---------------------------
# Brickognize
# ---------------------------
BRICKOGNIZE_MIN_SIMILARITY=0.72
BRICKOGNIZE_TOP_K=5

# ---------------------------
# BrickLink OAuth 1.0
# ---------------------------
BRICKLINK_CONSUMER_KEY=your_consumer_key
BRICKLINK_CONSUMER_SECRET=your_consumer_secret
BRICKLINK_TOKEN_VALUE=your_access_token
BRICKLINK_TOKEN_SECRET=your_token_secret

BRICKLINK_COUNTRY_CODE=
BRICKLINK_CURRENCY=USD
PRICE_CACHE_HOURS=6

# ---------------------------
# Search / processing
# ---------------------------
SEARCH_CONFIG=searches.json
CONTINUOUS_SCAN=false
SCAN_INTERVAL_MINUTES=5

MAX_FIGURES_PER_IMAGE=20
SAVE_BOXED_PREVIEWS=true
BOXED_PREVIEW_DIR=debug_boxes

DB_PATH=deal_finder.db
